{
  "name": "fe-ecommerce-nike-style",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,e2e}/**/*.{ts,tsx,json,css}\" \"*.{ts,mjs,json}\" && eslint src --fix",
    "format:check": "prettier --check \"{src,e2e}/**/*.{ts,tsx,json,css}\" \"*.{ts,mjs,json}\"",
    "typecheck": "tsc --noEmit",
    "gen:api": "node scripts/gen-api.mjs && prettier --write src/lib/api/generated/openapi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "analyze": "ANALYZE=true next build --webpack",
    "prepare": "husky"
  },
