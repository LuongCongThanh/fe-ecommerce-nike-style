# Copy this file to .env.local and fill in real values for your environment.
# .env.local is gitignored — never commit real secrets.

# Required — app will fail to build/start without these.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000/api

# Local development only. Enables MSW for storefront flows awaiting their API cutover.
NEXT_PUBLIC_API_MOCKING=true

# be-demo origin that Next.js proxies `/api/v1/*` to (server-only). Catalog pages always read the
# real API; cart, wishlist, auth and orders stay on MSW mocks until slice C.
API_ORIGIN=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional — payment gateways, only needed for checkout integration work.
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_URL=

# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=

# ZALOPAY_APP_ID=
# ZALOPAY_KEY1=
# ZALOPAY_KEY2=

# Optional — Cloudinary media uploads.
# NEXT_PUBLIC_CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional — Sentry error monitoring.
# NEXT_PUBLIC_SENTRY_DSN=
