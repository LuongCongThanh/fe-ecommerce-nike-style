    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@repo/api-sdk": "workspace:*",
    "@repo/schemas": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/ui": "workspace:*",
