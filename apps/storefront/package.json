    "next-nprogress-bar": "^2.4.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.82.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
