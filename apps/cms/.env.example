# Copy this file to .env.local and fill in real values for your environment.
# .env.local is gitignored — never commit real secrets.

# Required for @repo/api-sdk (Decision #28) — `true` boots MSW mock handlers on both server and
# browser; NEXT_PUBLIC_SITE_URL is the absolute origin the server-side fetch resolves against.
NEXT_PUBLIC_API_MOCKING=true
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3002
