# Copy this file to .env.local and fill in real values for your environment.
# .env.local is gitignored — never commit real secrets.

# Same mock-phase flags as the old Next.js admin app, renamed to Vite's `VITE_` prefix (Vite doesn't
# statically replace `process.env.NEXT_PUBLIC_*` — vite.config.ts's `define` block maps these onto
# the `process.env.NEXT_PUBLIC_*` names @repo/api-sdk itself reads, so that shared package needs no
# framework-specific changes).
VITE_API_MOCKING=true
VITE_SITE_URL=http://127.0.0.1:5183
