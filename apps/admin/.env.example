# Copy this file to .env.local and fill in real values for your environment.
# .env.local is gitignored — never commit real secrets.

# Same mock-phase flags as the old Next.js admin app, renamed to Vite's `VITE_` prefix.
# @repo/api-sdk reads these directly off `import.meta.env` (falling back to the Next.js app's
# `NEXT_PUBLIC_*` names on `process.env`), so no `define` shim is needed here.
VITE_API_MOCKING=true
VITE_SITE_URL=http://127.0.0.1:3001

# Better Auth server URL (see @repo/shared/better-auth) — the backend at this URL must run
# better-auth's own server handler + a DB adapter (not part of this repo). Optional: defaults to
# '/api/auth' (same-origin), which only works if that backend is reverse-proxied under this app's
# own origin — set a full URL (e.g. http://localhost:4000) otherwise.
VITE_BETTER_AUTH_URL=
