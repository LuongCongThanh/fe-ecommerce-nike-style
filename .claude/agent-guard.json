{
  "$comment": "Source of truth for .claude/hooks/agent-guard.ts and scripts/agent-run. Human-readable table: AGENT-SYSTEM-PLAN.md, section 'Deny list storefront'. Contract + env vars (AGENT_RUN, AGENT_PHASE, AGENT_TASK_DIR, AGENT_APPROVED): docs/plan/README.md, section 'Agent guard'. Always on (every session): secretFiles + stopFile. Only when AGENT_RUN=1: everything else.",
  "stopFile": ".agent-stop",
  "secretFiles": {
    "deny": [".env", ".env.*"],
    "allow": [".env.example"]
  },
  "allowCommands": [
    "pnpm typecheck",
    "pnpm lint",
    "pnpm lint:fix",
    "pnpm format",
    "pnpm format:check",
    "pnpm test",
    "pnpm build",
    "pnpm exec vitest run *",
    "pnpm exec eslint *"
  ],
  "readCommands": ["cat *", "ls *", "echo *", "cd *", "git diff *", "git log *", "git status *", "git rev-parse *", "git show *"],
  "outputFilters": ["tail", "head", "grep", "wc"],
  "denyCommandPatterns": ["\\brm\\s+(-\\S*\\s+)*-\\S*[rR]", "\\bfind\\b.*\\s-delete\\b", "\\s--output(=|\\s|$)"],
  "denyPaths": [
    "src/lib/api/generated/**",
    "pnpm-lock.yaml",
    "skills-lock.json",
    ".claude/**",
    ".codex/**",
    ".agents/**",
    ".mcp.json",
    "scripts/**",
    "docs/plan/AGENT-INBOX.md",
    ".agent-run/**",
    ".husky/**",
    "commitlint.config.mjs",
    "lint-staged.config.mjs",
    "eslint.config.mjs",
    ".prettierrc.mjs",
    ".prettierignore",
    "tsconfig.json",
    "tsconfig.scripts.json",
    "vitest.config.ts",
    "playwright.config.ts",
    ".github/workflows/**",
    ".github/PULL_REQUEST_TEMPLATE.md",
    "docs/adr/**",
    "AGENTS.md",
    "CLAUDE.md",
    "apps/**"
  ],
  "askPaths": ["package.json", "next.config.ts", "src/middleware.ts", ".gitignore"],
  "phases": {
    "plan": { "writeOnly": ["{taskDir}/plan.md"], "allowCommands": [], "readCommands": [] },
    "implement": { "writeAlso": ["{taskDir}/report.md"] },
    "retro": { "writeAlso": ["{taskDir}/report.md"] },
    "review": { "writeOnly": [], "allowCommands": [] }
  }
}
