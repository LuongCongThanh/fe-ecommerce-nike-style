{
  "$comment": "Executable source of truth for guard hooks and scripts/agent-run. Open policy: every path and command is allowed for agents; always on are secretFiles and stopFile, and plan/review phases keep their role limits. Contract: docs/agents/runner.md#guard-contract.",
  "stopFile": ".agent-stop",
  "secretFiles": {
    "deny": [".env", ".env.*"],
    "allow": [".env.example"]
  },
  "allowAllCommands": true,
  "allowCommands": [
    "pnpm typecheck",
    "pnpm lint",
    "pnpm lint:fix",
    "pnpm format",
    "pnpm format:check",
    "pnpm docs:check",
    "pnpm test",
    "pnpm build",
    "pnpm exec vitest run *",
    "pnpm exec eslint *"
  ],
  "readCommands": ["cat *", "ls *", "echo *", "cd *", "git diff *", "git log *", "git status *", "git rev-parse *", "git show *"],
  "outputFilters": ["tail", "head", "grep", "wc"],
  "denyCommandPatterns": [],
  "denyPaths": [],
  "askPaths": [],
  "phases": {
    "plan": {
      "writeOnly": ["{taskDir}/plan.md"],
      "allowCommands": [],
      "readCommands": []
    },
    "implement": {
      "writeAlso": ["{taskDir}/report.md"]
    },
    "retro": {
      "writeAlso": ["{taskDir}/report.md"]
    },
    "review": {
      "writeOnly": [],
      "allowCommands": []
    }
  }
}
